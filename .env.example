# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS Rekognition ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Mercado Pago ---
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Iris <noreply@iris.example.com>

# --- Z-API (WhatsApp) ---
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fee da plataforma em basis points (1% = 100 bps). 1500 = 15%.
# Override por organização disponível via `organizations.platform_fee_bps`.
IRIS_PLATFORM_FEE_BPS=1500

# --- Sentry (observabilidade) ---
# Deixe em branco para desabilitar.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
